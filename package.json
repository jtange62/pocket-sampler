{
  "name": "pocket-sampler",
  "productName": "Pocket Sampler",
  "version": "0.2.1",
  "description": "A 16-pad sampler and sequencer for Windows",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "smoke": "node scripts/launch.js --smoke",
    "icon": "python scripts/make_icon.py",
    "dist": "electron-builder --win"
  },
  "author": "Jason Tange",
  "license": "MIT",
  "build": {
    "appId": "io.askedgar.pocketsampler",
    "productName": "Pocket Sampler",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pocket Sampler",
      "artifactName": "PocketSampler-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "PocketSampler-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
